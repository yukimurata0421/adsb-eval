[Unit]
Description=adsb-eval dist_1m JSONL logger (append-only)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
OnFailure=adsb-eval-failure-notify@%n.service

[Service]
Type=oneshot

EnvironmentFile=-/etc/default/adsb-eval

# 初回実行でも失敗しないように事前作成
ExecStartPre=/usr/bin/bash -lc 'mkdir -p "${ADSB_LOG_DIR:-data/logs}" "${ADSB_STATE_DIR:-data/state}"'

# ADSB_BASE_DIR へ移動して実行。Python 側 lock に加え flock でも保険を掛ける。
ExecStart=/usr/bin/bash -lc 'cd "${ADSB_BASE_DIR:?set ADSB_BASE_DIR}" && exec /usr/bin/flock -n "${ADSB_STATE_DIR:-data/state}/adsb-dist.flock" /usr/bin/python3 -u src/adsb_dist_logger.py'

# Hardening (最低限)
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
