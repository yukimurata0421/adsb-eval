# Install example: copy to /etc/default/adsb-eval (or ~/.config/adsb-eval.env)

# Where repo is deployed
ADSB_BASE_DIR=/home/yuki/publish/adsb-eval

# Runtime dirs (gitignored)
ADSB_LOG_DIR=/home/yuki/publish/adsb-eval/data/logs
ADSB_STATE_DIR=/home/yuki/publish/adsb-eval/data/state

# readsb runtime
READSB_AIRCRAFT_JSON=/run/readsb/aircraft.json

# Site meta (required for dist logger)
ADSB_SITE_ID=T-RJAH114
ADSB_SITE_LAT=36.120055
ADSB_SITE_LON=140.232300

# Optional
ADSB_CONFIG_ID=gain19-e60_vinnant8p_2026-01-10
ADSB_GAIN_DB=33.8

# Summary behavior
ADSB_SUMMARY_LINES=120
ADSB_PUBLIC_MODE=1
